#!/usr/bin/env bash
# claude-with: launch Claude Code with per-invocation plugins/settings/context.
# No daemon, no config file, no persistent state. See README.md.
set -euo pipefail

VERSION="0.2.0"

# ── Colors (disabled if not a terminal) ──────────────────────
if [ -t 1 ]; then
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  RESET='\033[0m'
else
  RED="" YELLOW="" RESET=""
fi

error() { printf "${RED}[x]${RESET} %s\n" "$1" >&2; }
die()   { error "$1"; exit 1; }
warn()  { printf "${YELLOW}[!]${RESET} %s\n" "$1" >&2; }

# ── Where claude-with looks for plugin marketplaces/registry. Read-only,
# ── never written to. Overridable so tests exercise fixture directories
# ── instead of a developer's real ~/.claude. ──────────────────────────
PLUGINS_HOME="${CLAUDE_WITH_PLUGINS_HOME:-$HOME/.claude/plugins}"
REGISTRY_FILE="$PLUGINS_HOME/known_marketplaces.json"
MARKETPLACES_DIR="$PLUGINS_HOME/marketplaces"

usage() {
  cat <<EOF
claude-with v${VERSION}
Launch Claude Code with exactly the plugins, settings, and context you
choose for this invocation, without touching any persistent config.

Usage: claude-with [OPTIONS] [-- CLAUDE_ARGS...]
       claude-with doctor

Options:
  --plugin <name>          Enable a plugin for this session only
                            (repeatable, exact id: name@marketplace)
  --no-plugin <name>       Disable a plugin for this session only
                            (repeatable)
  --only-plugins <a,b,c>   Disable every other installed plugin, keeping
                            only the ones listed (requires 'claude plugin
                            list --json'; see README for limitations)
  --context <file-or-dir>  Load this file/dir INSTEAD OF discovered
                            CLAUDE.md files (repeatable)
  --no-context             Suppress all discovered CLAUDE.md/rules files
  --settings <json-or-file>  Extra settings to merge in (same shape as
                            'claude --settings'); claude-with's own
                            generated keys take precedence
  --dry-run                  Print the claude command and generated
                            settings JSON; run nothing
  --                          Everything after this is passed to claude
                            verbatim
  -h, --help                 Show this help
  -v, --version               Show version

Subcommands:
  doctor                     Check this machine's Claude Code plugin setup
                            (registry, marketplaces, claude on PATH) and
                            print OK/WARN/FAIL for each check.

Examples:
  claude-with --no-plugin typescript-lsp@claude-plugins-official
  claude-with --plugin x@marketplace --context docs/onboarding.md
  claude-with --only-plugins security-review@claude-plugins-official
  claude-with --dry-run --no-context
  claude-with doctor
EOF
}

# ── Plugin directory resolution ──────────────────────────────────────
# Resolves a "name@marketplace" plugin id to a directory suitable for
# 'claude --plugin-dir', by reading the marketplace.json that already
# exists on disk under $MARKETPLACES_DIR/<marketplace>/ -- NOT the
# registry's installLocation, which is what breaks when it points at a
# stale or another-machine path. If the resolved directory has no
# .claude-plugin/plugin.json (some marketplace entries carry the full
# manifest inline in marketplace.json instead, e.g. LSP plugins),
# synthesizes one in a temp directory of symlinks so --plugin-dir still
# has a valid manifest to read.
#
# Prints one of:
#   RESOLVED <dir>          on success (may be preceded by WARN lines)
#   WARN <message>          zero or more, printed before RESOLVED/FAIL
#   FAIL <message>          on failure, nothing else printed
# Exit code mirrors success (0) / failure (1).
resolve_plugin_dir() {
  local plugin_id="$1"
  CW_RESOLVE_PLUGIN_ID="$plugin_id" CW_RESOLVE_MARKETPLACES_DIR="$MARKETPLACES_DIR" python3 <<'PYEOF'
import json
import os
import sys
import tempfile

plugin_id = os.environ["CW_RESOLVE_PLUGIN_ID"]
marketplaces_dir = os.environ["CW_RESOLVE_MARKETPLACES_DIR"]

if "@" not in plugin_id:
    print(f"FAIL malformed plugin id (expected name@marketplace): {plugin_id}")
    sys.exit(1)
name, marketplace = plugin_id.split("@", 1)

mkt_root = os.path.join(marketplaces_dir, marketplace)
mkt_json_path = os.path.join(mkt_root, ".claude-plugin", "marketplace.json")
if not os.path.isfile(mkt_json_path):
    print(f"FAIL marketplace '{marketplace}' has no marketplace.json on disk at {mkt_json_path}")
    sys.exit(1)

try:
    with open(mkt_json_path) as f:
        mkt = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    print(f"FAIL could not read/parse {mkt_json_path}: {e}")
    sys.exit(1)

entry = None
for p in mkt.get("plugins", []):
    if p.get("name") == name:
        entry = p
        break
if entry is None:
    print(f"FAIL plugin '{name}' not found in marketplace '{marketplace}' on disk ({mkt_json_path})")
    sys.exit(1)

source = entry.get("source")
if isinstance(source, dict):
    print(f"FAIL plugin '{name}' has a remote '{source.get('source', '?')}' source in marketplace.json, "
          f"not a local path claude-with can resolve to a directory")
    sys.exit(1)
if not isinstance(source, str) or not source:
    print(f"FAIL plugin '{name}' has no usable 'source' field in marketplace.json")
    sys.exit(1)

rel = source[2:] if source.startswith("./") else source
plugin_dir = os.path.normpath(os.path.join(mkt_root, rel))
if not os.path.isdir(plugin_dir):
    print(f"FAIL resolved plugin directory does not exist on disk: {plugin_dir}")
    sys.exit(1)

manifest_path = os.path.join(plugin_dir, ".claude-plugin", "plugin.json")
if os.path.isfile(manifest_path):
    print(f"RESOLVED {plugin_dir}")
    sys.exit(0)

print(f"WARN plugin '{plugin_id}': resolved directory has no .claude-plugin/plugin.json "
      f"({manifest_path}); synthesizing one from the marketplace.json entry")
synth = dict(entry)
synth.pop("source", None)
synth.pop("category", None)
tmp_dir = tempfile.mkdtemp(prefix="claude-with-plugin.")
os.makedirs(os.path.join(tmp_dir, ".claude-plugin"))
with open(os.path.join(tmp_dir, ".claude-plugin", "plugin.json"), "w") as f:
    json.dump(synth, f, indent=2)
for child in os.listdir(plugin_dir):
    if child == ".claude-plugin":
        continue
    os.symlink(os.path.join(plugin_dir, child), os.path.join(tmp_dir, child))
print(f"RESOLVED {tmp_dir}")
print(f"SYNTH {tmp_dir}")
PYEOF
}

# ── General preflight, run on every real invocation (not --help/--version/
# ── doctor, which have their own paths). Warns; never blocks by itself. ──
run_preflight() {
  if ! command -v claude >/dev/null 2>&1; then
    warn "claude CLI not found on PATH"
  fi
  if [ ! -f "$REGISTRY_FILE" ]; then
    warn "plugin registry not found: $REGISTRY_FILE (marketplace installLocations cannot be checked; --plugin/--only-plugins still resolve directly from on-disk marketplace content)"
    return
  fi
  CW_REGISTRY_FILE="$REGISTRY_FILE" python3 <<'PYEOF' 2>/dev/null | while IFS= read -r line; do warn "$line"; done || true
import json
import os
import sys

path = os.environ["CW_REGISTRY_FILE"]
try:
    with open(path) as f:
        registry = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    print(f"could not read/parse plugin registry {path}: {e}")
    sys.exit(0)
if not isinstance(registry, dict):
    print(f"plugin registry {path} is not a JSON object (got {type(registry).__name__}); marketplace installLocations cannot be checked")
    sys.exit(0)

for name, entry in registry.items():
    loc = entry.get("installLocation") if isinstance(entry, dict) else None
    if loc and not os.path.exists(loc):
        print(f"marketplace '{name}' installLocation does not exist: {loc} "
              f"(stale/cross-machine registry entry; on-disk resolution is used instead for --plugin/--only-plugins)")
PYEOF
}

# ── `claude-with doctor` ──────────────────────────────────────────────
run_doctor() {
  local fail_count=0

  if command -v claude >/dev/null 2>&1; then
    echo "[OK]   claude binary on PATH ($(command -v claude))"
  else
    echo "[FAIL] claude binary not found on PATH"
    fail_count=$((fail_count + 1))
  fi

  if command -v python3 >/dev/null 2>&1; then
    echo "[OK]   python3 on PATH ($(command -v python3))"
  else
    echo "[FAIL] python3 not found on PATH (required to build/merge settings JSON)"
    fail_count=$((fail_count + 1))
  fi

  if [ -f "$REGISTRY_FILE" ]; then
    echo "[OK]   plugin registry found: $REGISTRY_FILE"
  else
    echo "[WARN] plugin registry not found: $REGISTRY_FILE"
  fi

  if [ -d "$MARKETPLACES_DIR" ]; then
    echo "[OK]   marketplaces directory found: $MARKETPLACES_DIR"
  else
    echo "[WARN] marketplaces directory not found: $MARKETPLACES_DIR"
  fi

  if [ -f "$REGISTRY_FILE" ]; then
    CW_REGISTRY_FILE="$REGISTRY_FILE" CW_MARKETPLACES_DIR="$MARKETPLACES_DIR" python3 <<'PYEOF'
import json
import os
import sys

reg_path = os.environ["CW_REGISTRY_FILE"]
marketplaces_dir = os.environ["CW_MARKETPLACES_DIR"]
try:
    with open(reg_path) as f:
        registry = json.load(f)
except (OSError, json.JSONDecodeError) as e:
    print(f"[FAIL] could not read/parse plugin registry {reg_path}: {e}")
    sys.exit(0)
if not isinstance(registry, dict):
    print(f"[FAIL] plugin registry {reg_path} is not a JSON object (got {type(registry).__name__})")
    sys.exit(0)

for name, entry in sorted(registry.items()):
    loc = entry.get("installLocation") if isinstance(entry, dict) else None
    on_disk = os.path.isdir(os.path.join(marketplaces_dir, name))
    if not loc:
        print(f"[WARN] marketplace '{name}': registry entry has no installLocation")
    elif os.path.exists(loc):
        print(f"[OK]   marketplace '{name}': installLocation exists ({loc})")
    else:
        note = " (on-disk content found at the expected marketplace path anyway)" if on_disk else " (no on-disk marketplace content found either)"
        print(f"[WARN] marketplace '{name}': installLocation does not exist: {loc}{note}")
PYEOF
  fi

  echo ""
  if [ "$fail_count" -gt 0 ]; then
    echo "doctor: $fail_count check(s) FAILED"
    return 1
  fi
  echo "doctor: no FAILs (see WARNs above for anything that needs attention)"
  return 0
}

if [ "${1:-}" = "doctor" ]; then
  run_doctor
  exit $?
fi

PLUGINS_ON=()
PLUGINS_OFF=()
ONLY_PLUGINS=""
CONTEXT_PATHS=()
NO_CONTEXT=0
USER_SETTINGS=""
DRY_RUN=0
CLAUDE_ARGS=()

while [ $# -gt 0 ]; do
  case "$1" in
    --plugin)
      [ $# -ge 2 ] || die "--plugin requires an argument"
      PLUGINS_ON+=("$2"); shift 2 ;;
    --no-plugin)
      [ $# -ge 2 ] || die "--no-plugin requires an argument"
      PLUGINS_OFF+=("$2"); shift 2 ;;
    --only-plugins)
      [ $# -ge 2 ] || die "--only-plugins requires an argument"
      ONLY_PLUGINS="$2"; shift 2 ;;
    --context)
      [ $# -ge 2 ] || die "--context requires an argument"
      CONTEXT_PATHS+=("$2"); shift 2 ;;
    --no-context)
      NO_CONTEXT=1; shift ;;
    --settings)
      [ $# -ge 2 ] || die "--settings requires an argument"
      USER_SETTINGS="$2"; shift 2 ;;
    --dry-run)
      DRY_RUN=1; shift ;;
    -h|--help)
      usage; exit 0 ;;
    -v|--version)
      echo "claude-with v${VERSION}"; exit 0 ;;
    --)
      shift
      while [ $# -gt 0 ]; do CLAUDE_ARGS+=("$1"); shift; done
      break ;;
    *)
      die "Unknown option: $1 (use -- to pass claude args verbatim)" ;;
  esac
done

command -v python3 >/dev/null 2>&1 || die "python3 is required (used to build/merge settings JSON)"

run_preflight

# ── Resolve directories whose CLAUDE.md/CLAUDE.local.md/rules would be
# ── auto-discovered (ancestors of cwd at launch, subdirectories of cwd
# ── on demand, ~/.claude), so --no-context / --context exclude them all. ──
claude_md_exclude_globs() {
  local dir="$PWD"
  local prefix
  local globs=()
  if [ "$dir" = "/" ]; then prefix=""; else prefix="$dir"; fi
  globs+=("$prefix/**/CLAUDE.md" "$prefix/**/CLAUDE.local.md" "$prefix/**/.claude/CLAUDE.md" "$prefix/**/.claude/rules/**")
  while :; do
    if [ "$dir" = "/" ]; then prefix=""; else prefix="$dir"; fi
    globs+=("$prefix/CLAUDE.md" "$prefix/CLAUDE.local.md" "$prefix/.claude/CLAUDE.md" "$prefix/.claude/rules/**")
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done
  globs+=("$HOME/.claude/CLAUDE.md" "$HOME/.claude/rules/**")
  printf '%s\n' "${globs[@]}" | sort -u
}

# ── --only-plugins: enumerate installed plugins, disable everything ──
# ── not explicitly kept. ──
if [ -n "$ONLY_PLUGINS" ]; then
  command -v claude >/dev/null 2>&1 || die "claude CLI not found on PATH"
  PLUGIN_LIST_JSON="$(claude plugin list --json 2>/dev/null)" || die "'claude plugin list --json' failed; cannot compute --only-plugins"
  ONLY_PLUGIN_IDS=()
  IFS=',' read -r -a ONLY_PLUGIN_IDS <<<"$ONLY_PLUGINS"
  INSTALLED_IDS=()
  while IFS= read -r installed_id; do
    [ -z "$installed_id" ] && continue
    INSTALLED_IDS+=("$installed_id")
  done < <(printf '%s' "$PLUGIN_LIST_JSON" | python3 -c 'import json,sys; [print(p["id"]) for p in json.load(sys.stdin)]')

  MISSING_IDS=()
  if [ "${#ONLY_PLUGIN_IDS[@]}" -gt 0 ]; then
    for k in "${ONLY_PLUGIN_IDS[@]}"; do
      found=0
      if [ "${#INSTALLED_IDS[@]}" -gt 0 ]; then
        for installed_id in "${INSTALLED_IDS[@]}"; do
          [ "$k" = "$installed_id" ] && found=1 && break
        done
      fi
      [ "$found" = 1 ] || MISSING_IDS+=("$k")
    done
  fi
  if [ "${#MISSING_IDS[@]}" -gt 0 ]; then
    MISSING_LIST="$(printf '%s, ' "${MISSING_IDS[@]}")"
    die "--only-plugins: not installed per 'claude plugin list --json': ${MISSING_LIST%, }"
  fi

  if [ "${#INSTALLED_IDS[@]}" -gt 0 ]; then
    for installed_id in "${INSTALLED_IDS[@]}"; do
      keep=0
      if [ "${#ONLY_PLUGIN_IDS[@]}" -gt 0 ]; then
        for k in "${ONLY_PLUGIN_IDS[@]}"; do
          [ "$k" = "$installed_id" ] && keep=1 && break
        done
      fi
      if [ "$keep" = 1 ]; then
        PLUGINS_ON+=("$installed_id")
      else
        PLUGINS_OFF+=("$installed_id")
      fi
    done
  fi
fi

# ── Temp files/dirs created for this invocation (a --settings file, any
# ── concatenated --context directories, any synthesized plugin dirs).
# ── Left in place on --dry-run so the printed command stays runnable;
# ── removed on exit otherwise (claude runs as a child process, not
# ── exec'd, so this trap fires). ──
TMPFILES=()
TMPDIRS=()
# shellcheck disable=SC2329  # invoked via trap EXIT
cleanup_tmpfiles() {
  [ "$DRY_RUN" = 1 ] && return
  if [ "${#TMPFILES[@]}" -gt 0 ]; then
    for f in "${TMPFILES[@]}"; do
      rm -f "$f"
    done
  fi
  if [ "${#TMPDIRS[@]}" -gt 0 ]; then
    for d in "${TMPDIRS[@]}"; do
      rm -rf "$d"
    done
  fi
}
trap cleanup_tmpfiles EXIT

# ── Resolve an on-disk --plugin-dir for every enabled plugin id (from
# ── --plugin and from --only-plugins' keep set), so the session actually
# ── loads the plugin's content even when the registry's installLocation
# ── is missing, stale, or points at a non-existent (e.g. another-machine)
# ── path. Dies with the reason if a requested plugin cannot be resolved
# ── to any on-disk directory at all. ──
PLUGIN_DIR_ARGS=()
if [ "${#PLUGINS_ON[@]}" -gt 0 ]; then
  SEEN_IDS=""
  SEEN_DIRS=""
  for plugin_id in "${PLUGINS_ON[@]}"; do
    case " $SEEN_IDS " in *" $plugin_id "*) continue ;; esac
    SEEN_IDS="$SEEN_IDS $plugin_id"

    RESOLVE_OUT="$(resolve_plugin_dir "$plugin_id" || true)"
    RESOLVED_DIR=""
    FAIL_REASON=""
    while IFS= read -r line; do
      case "$line" in
        "RESOLVED "*) RESOLVED_DIR="${line#RESOLVED }" ;;
        "WARN "*) warn "${line#WARN }" ;;
        "SYNTH "*) TMPDIRS+=("${line#SYNTH }") ;;
        "FAIL "*) FAIL_REASON="${line#FAIL }" ;;
      esac
    done <<<"$RESOLVE_OUT"

    if [ -z "$RESOLVED_DIR" ]; then
      die "cannot resolve plugin '$plugin_id' to any on-disk directory: ${FAIL_REASON:-unknown error}"
    fi
    case " $SEEN_DIRS " in
      *" $RESOLVED_DIR "*) ;;
      *) SEEN_DIRS="$SEEN_DIRS $RESOLVED_DIR"; PLUGIN_DIR_ARGS+=("$RESOLVED_DIR") ;;
    esac
  done
fi

# ── Build the enabledPlugins JSON fragment from PLUGINS_ON / PLUGINS_OFF. ──
CW_ON=""
if [ "${#PLUGINS_ON[@]}" -gt 0 ]; then
  CW_ON="$(printf '%s\n' "${PLUGINS_ON[@]}")"
fi
CW_OFF=""
if [ "${#PLUGINS_OFF[@]}" -gt 0 ]; then
  CW_OFF="$(printf '%s\n' "${PLUGINS_OFF[@]}")"
fi
export CW_ON CW_OFF

CW_ENABLED_PLUGINS_JSON="$(python3 <<'PYEOF'
import json, os
on = [l for l in os.environ.get("CW_ON", "").splitlines() if l]
off = [l for l in os.environ.get("CW_OFF", "").splitlines() if l]
out = {}
for name in off:
    out[name] = False
for name in on:
    out[name] = True
print(json.dumps(out))
PYEOF
)"
export CW_ENABLED_PLUGINS_JSON

# ── Build the claudeMdExcludes JSON fragment. ──
CW_CLAUDE_MD_EXCLUDES_JSON="[]"
if [ "$NO_CONTEXT" = 1 ] || [ "${#CONTEXT_PATHS[@]}" -gt 0 ]; then
  CW_CLAUDE_MD_EXCLUDES_JSON="$(claude_md_exclude_globs | python3 -c 'import json,sys; print(json.dumps([l.rstrip("\n") for l in sys.stdin]))')"
fi
export CW_CLAUDE_MD_EXCLUDES_JSON

# ── Merge everything into the final --settings JSON. Our generated keys ──
# ── (enabledPlugins, claudeMdExcludes) win over a user-supplied base. ──
export CW_USER_SETTINGS="$USER_SETTINGS"
SETTINGS_JSON="$(python3 <<'PYEOF'
import json, os

base_arg = os.environ.get("CW_USER_SETTINGS", "")
data = {}
if base_arg:
    if os.path.isfile(base_arg):
        with open(base_arg) as f:
            data = json.load(f)
    else:
        data = json.loads(base_arg)

enabled_plugins = json.loads(os.environ.get("CW_ENABLED_PLUGINS_JSON", "{}"))
if enabled_plugins:
    merged = dict(data.get("enabledPlugins", {}))
    merged.update(enabled_plugins)
    data["enabledPlugins"] = merged

excludes = json.loads(os.environ.get("CW_CLAUDE_MD_EXCLUDES_JSON", "[]"))
if excludes:
    existing = data.get("claudeMdExcludes", [])
    data["claudeMdExcludes"] = existing + [e for e in excludes if e not in existing]

print(json.dumps(data, indent=2, sort_keys=True))
PYEOF
)"

# claude-with writes settings to a temp FILE rather than passing the JSON
# inline on the command line. Empirically (v2.1.241), an inline
# `--settings '<json>'` string did not reliably apply `claudeMdExcludes`,
# while `--settings <file>` with the identical content did. See README's
# "Verified behavior" section.
SETTINGS_FILE=""
if [ -n "$SETTINGS_JSON" ] && [ "$SETTINGS_JSON" != "{}" ]; then
  SETTINGS_FILE="$(mktemp "${TMPDIR:-/tmp}/claude-with.XXXXXX")"
  TMPFILES+=("$SETTINGS_FILE")
  printf '%s\n' "$SETTINGS_JSON" > "$SETTINGS_FILE"
fi

# ── --context: append each file's content as a system-prompt addendum. ──
# ── For a directory, concatenate its regular files (sorted, one level  ──
# ── deep) into one temp file; only *.md and *.txt are included.        ──
APPEND_SYSTEM_PROMPT_FILES=()
if [ "${#CONTEXT_PATHS[@]}" -gt 0 ]; then
  for p in "${CONTEXT_PATHS[@]}"; do
    [ -e "$p" ] || die "--context path not found: $p"
    if [ -d "$p" ]; then
      tmp="$(mktemp "${TMPDIR:-/tmp}/claude-with.XXXXXX")"
      TMPFILES+=("$tmp")
      : > "$tmp"
      while IFS= read -r f; do
        cat "$f" >> "$tmp"
        printf '\n\n' >> "$tmp"
      done < <(find "$p" -maxdepth 1 -type f \( -name '*.md' -o -name '*.txt' \) | sort)
      APPEND_SYSTEM_PROMPT_FILES+=("$tmp")
    else
      APPEND_SYSTEM_PROMPT_FILES+=("$p")
    fi
  done
fi

# ── Assemble the claude invocation ──
CLAUDE_CMD=(claude)
if [ -n "$SETTINGS_FILE" ]; then
  CLAUDE_CMD+=(--settings "$SETTINGS_FILE")
fi
if [ "${#PLUGIN_DIR_ARGS[@]}" -gt 0 ]; then
  for d in "${PLUGIN_DIR_ARGS[@]}"; do
    CLAUDE_CMD+=(--plugin-dir "$d")
  done
fi
if [ "${#APPEND_SYSTEM_PROMPT_FILES[@]}" -gt 0 ]; then
  for f in "${APPEND_SYSTEM_PROMPT_FILES[@]}"; do
    CLAUDE_CMD+=(--append-system-prompt-file "$f")
  done
fi
if [ "${#CLAUDE_ARGS[@]}" -gt 0 ]; then
  CLAUDE_CMD+=("${CLAUDE_ARGS[@]}")
fi

if [ "$DRY_RUN" = 1 ]; then
  echo "# generated settings JSON:"
  echo "$SETTINGS_JSON"
  echo "# claude command:"
  printf '%q ' "${CLAUDE_CMD[@]}"
  echo
  exit 0
fi

CLAUDE_STATUS=0
"${CLAUDE_CMD[@]}" || CLAUDE_STATUS=$?
exit "$CLAUDE_STATUS"
